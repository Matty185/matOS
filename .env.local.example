# .env.local.example
# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────
# From supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never exposed to the browser,
# never imported outside server-only code (invite generation,
# audit log writes, seeding). Must be the "service_role" secret,
# NOT the anon key — check the "role" claim in the JWT if unsure.
SUPABASE_SERVICE_ROLE_KEY=

# CLI-only — needed to run `supabase link` / `supabase db push` /
# `supabase gen types` against the hosted project. Not read by the
# app itself. Access token: supabase.com/dashboard/account/tokens.
# DB password: Project Settings → Database.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# ── Anthropic ─────────────────────────────────────────────
# console.anthropic.com → API Keys. Used by the agentic interface
# (Haiku 4.5, server-side only).
ANTHROPIC_API_KEY=

# ── Resend (invite emails only) ──────────────────────────
# Can be blank until Stage 2 (invite flow).
RESEND_API_KEY=

# ── App ───────────────────────────────────────────────────
# Local dev; becomes the Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
