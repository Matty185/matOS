{
  "expo": {
    "name": "MatOS",
    "slug": "matos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "matos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.matos.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.matos.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B4F72",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4F72",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B4F72"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MatOS needs access to your videos to select match footage to analyze. Video is never uploaded — it stays on your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MatOS needs access to your camera to record BJJ rolls for tagging. Video is never uploaded — it stays on your device.",
          "microphonePermission": "MatOS needs access to your microphone to record audio with your rolls. Video is never uploaded — it stays on your device."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
